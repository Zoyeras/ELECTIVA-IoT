#include <DHT.h>

const int pinPIR = 3;
const int pinBuzzer = 16;
const int pinDHT = 2;
const int pinLDR = A0;

const int ledsRojos[] = {9, 10, 11, 12, 13};
const int numLedsRojos = 5;

const int ledCian = 5;
const int ledMorado = 18;
const int ledAmarillo = 19;

#define DHTTYPE DHT22
DHT dht(pinDHT, DHTTYPE);

int estadoPIR = LOW;
unsigned long tiempoMovimiento = 0;
const unsigned long duracionMovimiento = 2000;

unsigned long ultimaLecturaDHT = 0;
float temperatura = 0;
float humedad = 0;

void setup() {
  Serial.begin(9600);
  pinMode(pinPIR, INPUT);
  pinMode(pinBuzzer, OUTPUT);
  
  for (int i = 0; i < numLedsRojos; i++) {
    pinMode(ledsRojos[i], OUTPUT);
  }

  pinMode(ledCian, OUTPUT);
  pinMode(ledMorado, OUTPUT);
  pinMode(ledAmarillo, OUTPUT);

  dht.begin();
}

void loop() {
  int valorLuz = analogRead(pinLDR); 
  int ledsAEncender = map(valorLuz, 0, 1023, 5, 1); 
  ledsAEncender = constrain(ledsAEncender, 1, 5);

  for (int i = 0; i < numLedsRojos; i++) {
    if (i < ledsAEncender) {
      digitalWrite(ledsRojos[i], HIGH);
    } else {
      digitalWrite(ledsRojos[i], LOW);
    }
  }

  int lecturaPIR = digitalRead(pinPIR);

  if (lecturaPIR == HIGH) {
    digitalWrite(ledCian, HIGH);
    tone(pinBuzzer, 1000);
    tiempoMovimiento = millis();
  } else {
    if (millis() - tiempoMovimiento >= duracionMovimiento) {
      digitalWrite(ledCian, LOW);
      noTone(pinBuzzer);
    }
  }

  if (millis() - ultimaLecturaDHT >= 2000) {
    ultimaLecturaDHT = millis();
    temperatura = dht.readTemperature();
    humedad = dht.readHumidity();

    if (!isnan(temperatura) && !isnan(humedad)) {
      
      if (temperatura < 0) {
        digitalWrite(ledMorado, HIGH);
        delay(250);
        digitalWrite(ledMorado, LOW);
        delay(250);
      } 
      else if (temperatura >= 0 && temperatura <= 35) {
        digitalWrite(ledMorado, HIGH);
      } 
      else {
        digitalWrite(ledMorado, HIGH);
        delay(50);
        digitalWrite(ledMorado, LOW);
        delay(50);
      }

      if (humedad < 30) {
        digitalWrite(ledAmarillo, HIGH);
        delay(250);
        digitalWrite(ledAmarillo, LOW);
        delay(250);
      } 
      else if (humedad >= 30 && humedad <= 70) {
        digitalWrite(ledAmarillo, HIGH);
      } 
      else {
        digitalWrite(ledAmarillo, HIGH);
        delay(50);
        digitalWrite(ledAmarillo, LOW);
        delay(50);
      }
      
    }
  }

  delay(10);
}
