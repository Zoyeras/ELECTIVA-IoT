#include <DHT.h>

#define SENSOR_MOV 3
#define ZUMBADOR 16
#define SENSOR_DHT 2
#define SENSOR_LUZ A0

const uint8_t pinesRojos[] = {9, 10, 11, 12, 13};
const uint8_t CANT_ROJOS = 5;

#define LED_MOV 5
#define LED_TEMP 18
#define LED_HUM 19

DHT dht22(SENSOR_DHT, DHT22);

uint32_t temporizadorMov = 0;
uint32_t temporizadorDHT = 0;

void setup() {
  Serial.begin(9600);
  
  pinMode(SENSOR_MOV, INPUT);
  pinMode(ZUMBADOR, OUTPUT);
  
  for (uint8_t pin : pinesRojos) {
    pinMode(pin, OUTPUT);
  }

  pinMode(LED_MOV, OUTPUT);
  pinMode(LED_TEMP, OUTPUT);
  pinMode(LED_HUM, OUTPUT);

  dht22.begin();
}

// Función auxiliar para no repetir código de parpadeo
void parpadearLed(uint8_t pin, int tiempo) {
  digitalWrite(pin, HIGH);
  delay(tiempo);
  digitalWrite(pin, LOW);
  delay(tiempo);
}

void loop() {
  // 1. Control de LDR y LEDs rojos
  int nivelLuz = analogRead(SENSOR_LUZ); 
  int limiteLeds = map(nivelLuz, 0, 1023, CANT_ROJOS, 1); 
  limiteLeds = constrain(limiteLeds, 1, CANT_ROJOS);

  for (int i = 0; i < CANT_ROJOS; i++) {
    // Operador ternario para resumir el if/else
    digitalWrite(pinesRojos[i], (i < limiteLeds) ? HIGH : LOW);
  }

  // 2. Control de movimiento (PIR)
  if (digitalRead(SENSOR_MOV)) {
    digitalWrite(LED_MOV, HIGH);
    tone(ZUMBADOR, 1000);
    temporizadorMov = millis();
  } else if (millis() - temporizadorMov >= 2000) {
    digitalWrite(LED_MOV, LOW);
    noTone(ZUMBADOR);
  }

  // 3. Control de Temperatura y Humedad
  if (millis() - temporizadorDHT >= 2000) {
    temporizadorDHT = millis();
    float temp = dht22.readTemperature();
    float hum = dht22.readHumidity();

    if (!isnan(temp) && !isnan(hum)) {
      
      // Lógica de Temperatura
      if (temp < 0) {
        parpadearLed(LED_TEMP, 250);
      } else if (temp <= 35) { 
        digitalWrite(LED_TEMP, HIGH);
      } else {
        parpadearLed(LED_TEMP, 50);
      }

      // Lógica de Humedad
      if (hum < 30) {
        parpadearLed(LED_HUM, 250);
      } else if (hum <= 70) { 
        digitalWrite(LED_HUM, HIGH);
      } else {
        parpadearLed(LED_HUM, 50);
      }
    }
  }

  delay(10);
}
